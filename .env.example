# Leave both blank to run without accounts (local saves only).
# Set VITE_BACKEND=local to try accounts, cloud saves and the hub against a
# simulated in-browser server (development only).
VITE_BACKEND=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Public hub publishing (off unless set to on; also set HUB_ENABLED=true for the function)
VITE_HUB=

# Netlify function settings (set in the Netlify UI, never in the browser build)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# HUB_ENABLED=true
# HUB_MAX_MAP_MB=60
# HUB_MAX_PUBLISH_PER_DAY=20
# Play links (docs/DEPLOY.md, "Play links"). A long random secret; without it, links need an account.
# SHARE_IP_SALT=
# SHARES_ENABLED=true
# SHARE_MAX_PER_DAY=50
# SHARE_MAX_PER_USER=200
# SHARE_ANON_PER_DAY=10
# SHARE_ANON_UPDATES_PER_DAY=30
# SHARE_REPORTS_PER_DAY=20
# SHARE_TIMES_PER_HOUR=60

# Sign-in providers shown on the account page (comma separated; empty = email only)
VITE_AUTH_PROVIDERS=github,discord
